     <property name="styleSheet">
      <string notr="true">QPushButton {
    color: #FFFFFF; /* White text for contrast */
    background-color: #AA0000; /* Dark red background */
    border-radius: 5px; /* Consistent with the settings button */
    padding: 5px 10px; /* Same spacing as the settings button */
    border: none; /* Clean, minimal look */
}

QPushButton:hover {
    background-color: #8C0000; /* Slightly darker red on hover */
}

QPushButton:pressed {
    background-color: #700000; /* Even darker red when pressed */
}</string>
