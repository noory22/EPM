      <string notr="true">QPushButton {
    background-color: #28a745; /* Standard Green */
    color: white;
    border-radius: 5px;
    padding: 10px;
    font-size: 20px;
}
QPushButton:hover {
    background-color: #218838; /* Darker green for hover */
}
QPushButton:pressed {
    background-color: #218838; /* Even darker green for pressed */
    border-color:black

}
QPushButton:checked {
    background-color: #218838; /* Darker Green for checked (pressed) */
    border-color: black; /* Optional border for visual feedback */
}
QPushButton:disabled {
                background-color: #A5D6A7;  /* Lighter green for disabled state */
                color: #FFFFFF;
            }</string>
